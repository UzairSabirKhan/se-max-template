[
  {
    "type": "trigger",
    "group": "Trigger",
    "label": "Trigger",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "manual",
          "enum": [
            "manual",
            "interval",
            "daily"
          ],
          "title": "Mode",
          "type": "string"
        },
        "every_minutes": {
          "anyOf": [
            {
              "maximum": 1440,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Every Minutes"
        },
        "at_time": {
          "anyOf": [
            {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "At Time"
        },
        "timezone": {
          "default": "Asia/Karachi",
          "title": "Timezone",
          "type": "string"
        }
      },
      "title": "TriggerConfig",
      "type": "object"
    }
  },
  {
    "type": "fetch_page",
    "group": "Source",
    "label": "Fetch Page",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "$defs": {
        "VarRef": {
          "additionalProperties": false,
          "description": "A reference to a flow variable: {\"var\": \"name\"}. Never a template string.",
          "properties": {
            "var": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$",
              "title": "Var",
              "type": "string"
            }
          },
          "required": [
            "var"
          ],
          "title": "VarRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "url": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "$ref": "#/$defs/VarRef"
            }
          ],
          "title": "Url"
        }
      },
      "required": [
        "url"
      ],
      "title": "FetchPageConfig",
      "type": "object"
    }
  },
  {
    "type": "paginate",
    "group": "Navigate",
    "label": "Paginate",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "additionalProperties": false,
      "properties": {
        "next_selector": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Next Selector",
          "type": "string"
        },
        "max_pages": {
          "default": 3,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Pages",
          "type": "integer"
        }
      },
      "required": [
        "next_selector"
      ],
      "title": "PaginateConfig",
      "type": "object"
    }
  },
  {
    "type": "extract_list",
    "group": "Extract",
    "label": "Extract List",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "$defs": {
        "CountRange": {
          "additionalProperties": false,
          "properties": {
            "min": {
              "maximum": 500,
              "minimum": 0,
              "title": "Min",
              "type": "integer"
            },
            "max": {
              "maximum": 500,
              "minimum": 1,
              "title": "Max",
              "type": "integer"
            }
          },
          "required": [
            "min",
            "max"
          ],
          "title": "CountRange",
          "type": "object"
        },
        "FieldSpec": {
          "additionalProperties": false,
          "properties": {
            "name": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$",
              "title": "Name",
              "type": "string"
            },
            "selector": {
              "maxLength": 200,
              "minLength": 1,
              "title": "Selector",
              "type": "string"
            },
            "attr": {
              "anyOf": [
                {
                  "pattern": "^[A-Za-z_:][-A-Za-z0-9_:.]{0,39}$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Attr"
            },
            "type": {
              "enum": [
                "text",
                "price",
                "int",
                "url",
                "date",
                "stock"
              ],
              "title": "Type",
              "type": "string"
            },
            "required": {
              "default": false,
              "title": "Required",
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "selector",
            "type"
          ],
          "title": "FieldSpec",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "base_selector": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Base Selector",
          "type": "string"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/FieldSpec"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Fields",
          "type": "array"
        },
        "identity_key": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Identity Key",
          "type": "string"
        },
        "page_anchor": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page Anchor"
        },
        "expected_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/CountRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "base_selector",
        "fields",
        "identity_key"
      ],
      "title": "ExtractListConfig",
      "type": "object"
    }
  },
  {
    "type": "for_each",
    "group": "Control",
    "label": "For Each",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "$defs": {
