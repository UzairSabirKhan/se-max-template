          "title": "VarRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "source": {
          "anyOf": [
            {
              "const": "items",
              "type": "string"
            },
            {
              "$ref": "#/$defs/VarRef"
            }
          ],
          "default": "items",
          "title": "Source"
        },
        "max_items": {
          "default": 25,
          "maximum": 25,
          "minimum": 1,
          "title": "Max Items",
          "type": "integer"
        },
        "on_error": {
          "default": "skip",
          "enum": [
            "skip",
            "stop"
          ],
          "title": "On Error",
          "type": "string"
        }
      },
      "title": "ForEachConfig",
      "type": "object"
    }
  },
