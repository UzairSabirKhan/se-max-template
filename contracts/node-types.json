  {
    "type": "condition",
    "group": "Control",
    "label": "Condition",
    "disabled": false,
    "disabled_reason": null,
    "config_schema": {
      "$defs": {
        "Rule": {
          "additionalProperties": false,
          "properties": {
            "field": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$",
              "title": "Field",
              "type": "string"
            },
            "op": {
              "enum": [
                "lt",
                "lte",
                "gt",
                "gte",
                "eq",
                "neq",
                "contains",
                "not_contains",
                "is_empty",
                "not_empty",
                "is_new",
                "is_removed",
                "changed",
                "increased",
                "decreased",
                "drop_pct_gt",
                "rise_pct_gt",
                "in_stock",
                "out_of_stock",
                "back_in_stock"
              ],
              "title": "Op",
              "type": "string"
            },
            "value": {
              "anyOf": [
                {
                  "maxLength": 200,
                  "type": "string"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "number"
                },
                {
                  "$ref": "#/$defs/VarRef"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Value"
            }
          },
          "required": [
            "field",
            "op"
          ],
          "title": "Rule",
          "type": "object"
        },
        "VarRef": {
          "additionalProperties": false,
          "description": "A reference to a flow variable: {\"var\": \"name\"}. Never a template string.",
          "properties": {
            "var": {
              "pattern": "^[a-z][a-z0-9_]{0,39}$",
              "title": "Var",
              "type": "string"
            }
          },
          "required": [
            "var"
          ],
          "title": "VarRef",
          "type": "object"
        }
      },
      "additionalProperties": false,
      "properties": {
        "match": {
          "default": "all",
          "enum": [
            "all",
            "any"
          ],
          "title": "Match",
          "type": "string"
        },
        "rules": {
          "items": {
            "$ref": "#/$defs/Rule"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "rules"
      ],
      "title": "ConditionConfig",
      "type": "object"
    }
  },
