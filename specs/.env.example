# Copy to .env and fill in real values locally. Never commit .env.
# Placeholder values only.

# Postgres connection (Neon free tier works)
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname

# Sidebar agent (PydanticAI). Primary model, then fallback if it fails. Runs never use AI.
# Format: "<provider>:<model>", e.g. google-gla:<gemini-model> and anthropic:claude-sonnet-5-5
AI_MODEL=google-gla:model-name-here
AI_FALLBACK_MODEL=anthropic:model-name-here
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here

# Comma-separated hosts the engine may fetch. Default: the app's own host (mock shop only).
ALLOWED_DOMAINS=your-app.onrender.com

# Public URL of this deployment (used for mock shop links)
PUBLIC_BASE_URL=https://your-app.onrender.com
