# Copy to .env and fill in real values locally. Never commit .env.
# Placeholder values only. On Railway / Render, set these in the dashboard instead.

# --- Database -------------------------------------------------------------------------------------
# Railway: add a PostgreSQL database and set DATABASE_URL=${{Postgres.DATABASE_URL}}.
# Render:  paste a free Neon connection string as-is (sslmode/channel_binding are handled).
# Locally: leave empty to use a SQLite file (scrapeonce.db). Required on any host.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# --- Sidebar assistant (design time only; runs never use AI) --------------------------------------
# "<provider>:<model>". Providers: google (Gemini), groq, anthropic (Claude).
# AI_FALLBACK_MODEL may list several, comma-separated, tried in order when the one before fails.
# A model whose key is missing is skipped, so set only the keys you have.
AI_MODEL=google:model-name-here
AI_FALLBACK_MODEL=groq:model-name-here,anthropic:model-name-here
GEMINI_API_KEY=your-gemini-key-here
GROQ_API_KEY=your-groq-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
# Optional second key per provider (e.g. another account). When the first key fails, for example
# its free quota runs out, the same model is tried with this key before moving to the next model.
GEMINI_API_KEY_2=
GROQ_API_KEY_2=
ANTHROPIC_API_KEY_2=

# --- Scraping -------------------------------------------------------------------------------------
# Public URL of this deployment (used for mock shop links)
PUBLIC_BASE_URL=https://your-app.up.railway.app
